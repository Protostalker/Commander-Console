# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Password for the Commander service account (set on the Commander unit itself)
COMMANDER_PASSWORD=your_service_account_password_here

# Stop attempting Commander logins after this many consecutive failures
# instead of retrying every poll cycle forever -- see README's "Login
# circuit breaker" section. Fix via POST /api/credentials, which also
# clears this counter (no restart needed either way).
COMMANDER_LOCKOUT_THRESHOLD=3

# Optional -- if set, POST /api/credentials requires this value in an
# X-API-Key header. Leave unset for a trusted LAN deployment.
# CONFIG_API_KEY=
