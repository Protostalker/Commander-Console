# Copy this file to .env and fill in your values.
# Never commit .env to version control.

COMMANDER_HOST=192.168.31.11
COMMANDER_PORT=443
COMMANDER_USERNAME=MANAGER
COMMANDER_PASSWORD=change_me
COMMANDER_VERIFY_SSL=false

POLL_INTERVAL_SECONDS=60
SESSION_REFRESH_MINUTES=25

# Stop attempting Commander logins after this many consecutive failures,
# rather than retrying every poll cycle forever -- see README's "Login
# circuit breaker" section. Fix via POST /config/credentials, which also
# clears this counter.
COMMANDER_LOCKOUT_THRESHOLD=3

# Optional -- if set, POST /config/credentials requires this value in an
# X-API-Key header. Leave unset to match the rest of this service's
# no-auth-on-a-trusted-LAN model.
# CONFIG_API_KEY=

PORT=8200
LOG_LEVEL=INFO
